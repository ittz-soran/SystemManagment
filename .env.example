APP_NAME="Store Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Baghdad

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# The password the administrator account is created with, the first time the
# database is seeded. Leave it empty and a random one is generated and printed
# once, at install. Either way, change it at /profile afterwards — and never
# leave this system reachable from the internet on a password anybody could
# guess: that account opens every screen the shop has.
ADMIN_PASSWORD=

# How much space this shop is allowed, in megabytes.
#
# For an install sold on a monthly plan. Set it here on the server and nowhere
# else: the Settings screen shows the meter but cannot raise it, because a limit
# the buyer can edit is not a limit.
#
# The meter turns amber at 80% and red at 95%, with a banner on every page an
# admin opens. At 100% the shop can no longer save anything new — reading,
# printing and deleting all keep working, so the shop can free space and carry
# on trading from what it already has.
#
# Leave it empty and there is no limit, no meter and no banner. That is what
# every install not sold on a plan should look like.
STORAGE_LIMIT_MB=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=store_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# On a machine in the shop, leave this alone. The moment the system is reachable
# over the internet, set it to true and serve the site over HTTPS: without it the
# browser will hand the session cookie to a plain http:// request, and whoever is
# sharing the wifi has the till.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Section 8b — backups. BACKUP_REMOTE_PATH is the one that matters: it must be a
# drive or share that is NOT this machine, because a dead disk should not take
# both the database and its backups. Leave it unset only while testing.
BACKUP_REMOTE_PATH=
BACKUP_AT=02:15
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12

# Only needed when mysqldump is not on PATH and not in one of the usual places.
# XAMPP keeps it in C:\xampp\mysql\bin and adds nothing to PATH.
#
# Forward slashes, and no quotes. Windows accepts them, and a quoted Windows path
# does not survive this file: dotenv reads the \x of \xampp inside double quotes
# as an escape sequence and refuses to parse, so the whole app stops booting with
# "The environment file is invalid!".
# MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
# MYSQL_PATH=C:/xampp/mysql/bin/mysql.exe
